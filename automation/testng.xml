<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Full regression suite: every API test followed by every UI test. -->
<suite name="TaskFlow Regression Suite" verbose="1">

    <test name="API Tests">
        <classes>
            <class name="tests.AuthTest"/>
            <class name="tests.TaskTest"/>
            <class name="tests.CategoryTest"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="tests.UiLoginTest"/>
            <class name="tests.UiSignupTest"/>
            <class name="tests.UiTaskTest"/>
        </classes>
    </test>

</suite>
